modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dependency-audit"

[[workflows.workflow]]
name = "dependency-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run audit:release"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["maestro"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY = "goog_oKaaAvrzOkZTXaWVRIkYSbvrOQq"
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_OfSYcEvCwyDpfNqTMWCTRtGnCkc"
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_mnmdwtOOEAawaIUeFAoyKZQflod"
REVENUECAT_APPLE_APP_STORE_APP_ID = "app24378a1078"
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID = "app3202103015"
REVENUECAT_PROJECT_ID = "proj9890aae2"
REVENUECAT_TEST_STORE_APP_ID = "app48c13d884c"

[userenv.production]
COACH_FACT_CONTEXT_ENABLED = "false"
RELEASE_SENSITIVE_ACTIVATION_REQUESTED = "false"
RELEASE_SENSITIVE_ACTIVATION_COMMIT = "5f69c31e4816abcfa5fff69389e4699fd4f1428f"

[userenv.development]
COACH_FACT_CONTEXT_ENABLED = "true"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 25115
externalPort = 80
