auto-install-peers=false
strict-peer-dependencies=false
# EAS Build bundles its own pnpm version which may be older than the lockfile
# format version. Disabling frozen-lockfile lets the install succeed in that
# environment; the lockfile is still read and respected, it just won't error
# on a version mismatch.
frozen-lockfile=false

# Force pnpm to hoist all packages to the root node_modules.
# This ensures that Expo's Metro bundler can find all dependencies (including peer deps)
# in a monorepo environment, resolving "Unable to resolve module" errors.
public-hoist-pattern[]=*
