# CaloraApp — Environment variable reference
#
# NEVER commit real values to source control.
# Configure each variable through Replit Secrets or your CI/CD secrets manager.
#
# ── Mobile client (Expo) ──────────────────────────────────────────────────
# Variables prefixed EXPO_PUBLIC_* are safe to expose in the Expo app bundle.
# They are visible to anyone who inspects the built binary.

# HTTPS origin for the deployed Calora API server. Do not append `/api`.
# Required in every EAS environment used by a native build (development, preview,
# and production). Native apps cannot resolve relative `/api/...` URLs.
EXPO_PUBLIC_API_URL=https://api.example.com

# Supabase project URL (from Supabase dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous / public key (from Supabase dashboard → Project Settings → API)
# The anon key has row-level security applied — it is safe to embed in the client.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── API server (Express — server-side ONLY) ──────────────────────────────
# These values must NEVER appear in the Expo bundle or any client-side code.

# PostgreSQL connection string — Replit-managed or Supabase (Transaction Pooler mode
# for serverless/Replit environments; Direct mode for migration runs).
DATABASE_URL=postgresql://user:password@host:port/database

# Supabase service-role key — grants full database bypass; server-side only.
# Used by the Express auth middleware to verify JWTs and perform admin operations.
# NEVER expose this in the Expo app bundle, logs, or client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase JWT secret — used to verify Supabase-issued JWTs on the Express server.
# Found in Supabase dashboard → Project Settings → API → JWT Settings.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Express session secret (already configured)
SESSION_SECRET=your-session-secret-here
