{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "verify:release": "node ../../scripts/verify-api-release.mjs",
    "verify:release-identity": "node ../../scripts/verify-api-runtime-identity.mjs",
    "verify:public-release": "node ./scripts/verify-public-release.mjs",
    "test:account-deletion-fence": "vitest run src/__tests__/accountDeletionFence.integration.test.ts",
    "test:recipe-media-persistence": "vitest run src/__tests__/recipe-media.persistence.integration.test.ts",
    "test:integration:postgres": "vitest run src/__tests__/accountDeletionFence.integration.test.ts src/__tests__/capture.persistence.integration.test.ts src/__tests__/coachFactConsent.integration.test.ts src/__tests__/recipe-media.persistence.integration.test.ts src/__tests__/recoverySummaryRollingRestart.integration.test.ts src/__tests__/recoveryWarningSuppression.integration.test.ts src/__tests__/referral-concurrency.integration.test.ts src/__tests__/referral-qualification.integration.test.ts src/__tests__/sync.integration.test.ts src/__tests__/tenant-isolation.integration.test.ts",
    "test:offline": "vitest run --exclude '**/*.integration.test.ts'",
    "test:built-deletion-fence-release": "node --test --test-name-pattern='built API deletion-fence validation' ../../scripts/verify-api-release.test.mjs",
    "test:monitoring": "node --test ../../scripts/monitor-account-deletion-fence.test.mjs",
    "test:release-attestation": "node --test ../../scripts/provider-package-attestation.test.mjs ../../scripts/verify-api-release.test.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.112.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.3",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.0",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.11"
  }
}
