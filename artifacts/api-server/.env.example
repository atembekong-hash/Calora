# Calora API server — environment variable reference
#
# Server-only values. Never place these values in an Expo bundle, client-side
# module, public endpoint, workflow summary, artifact, or repository commit.
# Configure them through the approved deployment secret manager.

# Calora API PostgreSQL data plane. This is distinct from the Supabase Auth
# control plane below. Its host, database, role, and password are secret-bearing
# and must never be derived from EXPO_PUBLIC_SUPABASE_URL or logged.
DATABASE_URL=postgresql://user:password@host:5432/database

# Opaque deployment-governed label for the approved API database target. This
# is not a URL, host name, role, database name, or connection-string hash.
# It is for protected, read-only provenance verification only and must never be
# exposed through /api/version or client code.
CALORA_API_DATABASE_TARGET_ID=approved-production-target-label

# Supabase Auth/Admin control plane. This key can administer Supabase Auth and
# must remain server-only; it is not a PostgreSQL DATABASE_URL credential.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret

# Session signing secret for the Express server.
SESSION_SECRET=replace-with-server-only-secret
