# Calora API server — source-backed environment variable reference
#
# This file documents names and behavior only. It intentionally contains no
# deployable values. Store secrets in the approved deployment secret manager;
# never expose them through Expo public configuration, logs, API responses,
# workflow summaries, build artifacts, or repository commits.

# Required to start. Startup validates DATABASE_URL with SELECT 1 before the
# HTTP listener opens. PORT must be a positive integer.
PORT=
DATABASE_URL=
NODE_ENV=

# Deployment-owned compatibility/provenance settings. Current API source does
# not read these at runtime, but release tooling or the hosting boundary may.
# The target id must be an opaque label, never a connection string or hash.
CALORA_API_DATABASE_TARGET_ID=
SESSION_SECRET=

# Required for authenticated API routes. Despite the EXPO_PUBLIC prefix, these
# values are read here by the server-side Supabase verifier. The service-role
# key is additionally required for account deletion and must remain server-only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required by the server-side AI integration module. Both are secret-bearing
# deployment integration settings; do not substitute a client API key.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# RevenueCat. REVENUECAT_PROJECT_ID is required for Premium authorization,
# referral grants, and account erasure. Customer erasure also requires the
# server-only secret key. Referral grants use the separately provisioned
# RevenueCat connector and never a client SDK key.
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_API_KEY=

# Object storage. Required for recipe-photo persistence and for the deletion
# saga to positively erase a user's recipe-photo prefix before Auth removal.
# Railway Buckets expose compatible BUCKET, ENDPOINT, ACCESS_KEY_ID,
# SECRET_ACCESS_KEY, and REGION values through service variable references.
# The RECIPE_PHOTO_* aliases make the runtime explicit and portable.
RECIPE_PHOTO_BUCKET=
RECIPE_PHOTO_STORAGE_ENDPOINT=
RECIPE_PHOTO_ACCESS_KEY_ID=
RECIPE_PHOTO_SECRET_ACCESS_KEY=
RECIPE_PHOTO_STORAGE_REGION=
RECIPE_PHOTO_STORAGE_FORCE_PATH_STYLE=false

# Public web and platform association settings. Production CORS always permits
# https://mycaloraapp.com; add only comma-separated HTTPS origins. Missing app
# association values make their corresponding well-known route return 503.
PUBLIC_WEB_ORIGIN=
CORS_ALLOWED_ORIGINS=
APPLE_TEAM_ID=
APPLE_APP_STORE_ID=
ANDROID_SHA256_FINGERPRINT=

# Food and recipe providers. USDA falls back to DEMO_KEY when omitted.
# THEMEALDB_API_KEY enables its configured catalogue. Premium recipes can use
# either the generic provider pair or the FatSecret direct/gateway settings.
USDA_FOODDATA_API_KEY=
THEMEALDB_API_KEY=
PREMIUM_RECIPE_PROVIDER_URL=
PREMIUM_RECIPE_PROVIDER_NAME=
PREMIUM_RECIPE_PROVIDER_API_KEY=
PREMIUM_RECIPE_PROVIDER_TIMEOUT_MS=
PREMIUM_RECIPE_ACCESS_MODE=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
FATSECRET_GATEWAY_URL=
FATSECRET_GATEWAY_SECRET=

# Runtime limits and logging. Source defaults are used when omitted.
LOG_LEVEL=
OPENAI_TIMEOUT_MS_OVERRIDE=
RECIPE_AI_MAX_CONCURRENT=
RECIPE_AI_CALLS_PER_WINDOW=
RECIPE_AI_WINDOW_MS=

# Coach Fact Context remains fail-closed. Setting this flag alone cannot enable
# production: CALORA_RELEASE_COMMIT must exactly match the clean reviewed Git
# commit compiled into the deployed API artifact. Set it only after verifying
# Railway's deployment metadata for that exact source revision.
COACH_FACT_CONTEXT_ENABLED=
CALORA_RELEASE_COMMIT=

# Test-only deletion-recovery rehearsal seed. Never configure in production.
CALORA_RECOVERY_SUMMARY_REHEARSAL_SEED=

# Build-time release attestation. Production builds require the four
# RELEASE_ATTESTATION_* enrollment settings. Sensitive activation is optional
# defense in depth and, when requested, requires the reviewed commit plus every
# RELEASE_PROVIDER_* field.
RELEASE_ATTESTATION_MANIFEST_DIR=
RELEASE_ATTESTATION_SIGNING_KEY=
RELEASE_ATTESTATION_SIGNING_KEY_FINGERPRINT=
RELEASE_ATTESTATION_ARTIFACT_DIR=
RELEASE_ATTESTATION_ARTIFACT_NAME=
RELEASE_SENSITIVE_ACTIVATION_REQUESTED=
RELEASE_SENSITIVE_ACTIVATION_COMMIT=
RELEASE_PROVIDER_ATTESTATION_FILE=
RELEASE_PROVIDER_ATTESTATION_SIGNATURE_FILE=
RELEASE_PROVIDER_ATTESTATION_PUBLIC_KEY_FILE=
RELEASE_PROVIDER_TRUSTED_PUBLIC_KEY_SHA256=
RELEASE_PROVIDER_DEPLOYMENT_ID=
RELEASE_PROVIDER_TARGET_ORIGIN=
