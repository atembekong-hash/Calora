# Calora mobile and web client — environment variable reference
#
# NEVER commit real values to source control. Configure each variable through
# the approved mobile build environment. Values prefixed EXPO_PUBLIC_* are
# bundled into the native app and must be safe for public distribution.
#
# Server-only variables such as DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and
# SESSION_SECRET are documented only in artifacts/api-server/.env.example.
# They must never appear in this mobile template or an Expo bundle.

# HTTPS origin for the deployed Calora API server. Do not append `/api`.
# Required in every EAS environment used by a native build (development,
# preview, and production). Native apps cannot resolve relative `/api/...`.
EXPO_PUBLIC_API_URL=https://api.example.com

# Supabase Auth project URL (from Supabase dashboard → Project Settings → API).
# This identifies the Auth/control plane; it is not the API PostgreSQL data plane.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key. The anon key is bundle-visible and subject to
# Supabase Auth and row-level-security policy; it is never a service-role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Bare public hostname used by the browser deployment. Do not include a scheme,
# port, path, query, or fragment. The production browser app uses a dedicated
# host so the existing apex API and native associated-link routes remain stable.
EXPO_PUBLIC_DOMAIN=app.mycaloraapp.com

# RevenueCat Test Store SDK key. Required for web, Expo Go, and development
# runtimes. This is a public client SDK key, never a RevenueCat secret API key.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_public_sdk_key_here

# The production browser build intentionally uses its own origin as the API
# origin. The web server relays /api/* to the canonical apex API so browser
# requests stay same-origin. Native builds continue using the canonical API
# origin configured in their EAS environment.
# EXPO_PUBLIC_API_URL=https://app.mycaloraapp.com
