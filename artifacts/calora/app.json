{
  "expo": {
    "name": "Calora",
    "slug": "calora",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caloraapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f8f3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.etiendem.caloraapp",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Calora uses Motion & Fitness activity to show your live steps while the dashboard is open.",
        "NSHealthUpdateUsageDescription": "Calora may request Apple Health access so you can choose health data to share. Calora only reads steps, active energy, workouts, and body weight; it does not write or change your Apple Health records."
      },
      "associatedDomains": [
        "applinks:mycaloraapp.com"
      ]
    },
    "android": {
      "package": "com.etiendem.caloraapp",
      "versionCode": 25,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_WEIGHT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mycaloraapp.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mycaloraapp.com",
              "path": "/auth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://mycaloraapp.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Calora uses your camera to identify food and scan product barcodes.",
          "microphonePermission": "Calora uses your microphone only while you record a short meal description."
        }
      ],
      "./plugins/withHealthConnectPrivacyPolicy.cjs",
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false,
          "NSHealthShareUsageDescription": "Calora reads steps, active energy, workouts, and body weight you choose to share.",
          "NSHealthUpdateUsageDescription": "Calora may request Apple Health access so you can choose health data to share. Calora only reads steps, active energy, workouts, and body weight; it does not write or change your Apple Health records."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "vvault07",
    "extra": {
      "eas": {
        "projectId": "1f202325-5b9a-4260-978f-abbd3252b9ee"
      }
    }
  }
}
